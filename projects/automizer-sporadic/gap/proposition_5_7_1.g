# Proposition 5.7.1 (the witness in the triple and sixfold covers)
#
# Triple cover: H of order 81 with full automizer of order 1296, identified
# with the block group F; O2(F) = 1, no normal C3, weight orbits
# 8, 8, 16, 16, 16, 16. Coprime transport gives the sextuple cover.
#
# Expected: the recorded output (GAP 4.12.1) ends with
#   ALL F1296 FULL COVER PRESENCE AND ACTION CHECKS PASSED
# Original file: fi22_f1296_cover_presence_certificate.g (L. Gong and Y. Yan, 2026-10-25).
# Change: 3.O7(3) is read from gap/data/3o73_p1134b0.g1, .g2 (the representation that
# AtlasGroup("3.O7(3)",IsPermGroup) returns only with remote access) instead of AtlasGroup.
# Usage: gap -q --quitonbreak gap/lib.g gap/proposition_5_7_1.g
LoadPackage("atlasrep");;
S:=AtlasGroup("Fi22",IsPermGroup);;
O:=AtlasSubgroup(S,2);;
# 3.O7(3) on 1134 points, AtlasRep "3O73G1-p1134B0" (standard generators 1, from the
# ctblocks data extension, remote access only), saved in gap/data/.
Read("gap/data/3o73_p1134b0.g1");;o73a:=bin1;;Read("gap/data/3o73_p1134b0.g2");;o73b:=bin1;;
Eo:=Group(o73a,o73b);;Assert(0,Size(Eo)=13756055040);
rho:=GroupHomomorphismByImages(Eo,O,GeneratorsOfGroup(Eo),GeneratorsOfGroup(O));;
if rho=fail or Size(Kernel(rho))<>3 then Error("orthogonal cover map failed");fi;
T:=AtlasGroup("3.U6(2)",IsPermGroup);;M:=AtlasSubgroup(S,1);;
eta:=NaturalHomomorphismByNormalSubgroup(M,Centre(M));;
mu:=GroupHomomorphismByImages(T,Image(eta),GeneratorsOfGroup(T),List(GeneratorsOfGroup(M),x->Image(eta,x)));;
if mu=fail or Size(Kernel(mu))<>3 then Error("unitary cover map failed");fi;
HsuExplicit:=Group(
