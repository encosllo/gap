    (2114,2787,2623)(2115,2978,2615)(2116,2446,2802)(2117,2183,3084)
    (2128,2158,3275)(2136,3001,2754)(2141,3074,2172)(2151,3002,2642)
    (2173,3268,2628)(2177,2725,3294)(2184,2747,2513)(2195,3030,2986)
    (2203,3157,2433)(2216,2365,2260)(2229,2295,3466)(2230,2824,2504)
    (2233,2980,3095)(2244,3038,2391)(2249,2823,2751)(2250,2833,2460)
    (2252,3479,2418)(2254,2828,2589)(2255,2743,3337)(2284,2382,2397)
    (2289,2977,3469)(2308,2542,3324)(2321,2792,2324)(2328,2972,2428)
    (2344,3029,2585)(2351,2966,3444)(2384,3208,2925)(2385,3379,2956)
    (2411,2618,2726)(2421,2687,3447)(2425,2766,2732)(2427,2937,2959)
    (2527,2758,3100)(2551,3265,3048)(2560,2953,3381)(2561,2818,2590)
    (2616,3046,3326)(2635,3189,3476)(2651,2903,3239)(2660,2846,2912)
    (2672,3115,2707)(2693,2999,3266)(2711,3491,3477)(2722,2819,3139)
    (2741,3217,3472)(2757,3134,3312)(2806,3051,3004)(2831,3238,3260)
    (2906,2949,3244)(2911,3223,2943)(2945,3307,3119)(2984,3054,3502)
    (2993,3081,3282)(3031,3338,3471)(3093,3448,3410)(3180,3394,3478)
    (3336,3443,3341) ]);;

if not IsSubgroup(T,HsuExplicit) or Size(HsuExplicit)<>81 or Size(Centre(HsuExplicit))<>9 or Size(DerivedSubgroup(HsuExplicit))<>3 or Exponent(HsuExplicit)<>3 or not IsSubgroup(HsuExplicit,Centre(T)) then Error("wrong unitary subgroup");fi;
nt:=Normalizer(T,HsuExplicit);;ct:=Centralizer(nt,HsuExplicit);;F:=FactorGroup(nt,ct);;
if Size(nt)<>11664 or Size(ct)<>9 or Size(F)<>1296 then Error("wrong local automizer");fi;
if Size(PCore(F,3))<>81 or not IsElementaryAbelian(PCore(F,3)) or IdGroup(SylowSubgroup(F,2))<>[16,12] then Error("wrong target group");fi;
Kunit:=SylowSubgroup(PreImage(eta,Image(mu,HsuExplicit)),3);;
if not IsSubgroup(O,Ktarget1296) or Size(Ktarget1296)<>27 or not IsElementaryAbelian(Ktarget1296) then Error("wrong orthogonal image");fi;
if RepresentativeAction(S,Kunit,Ktarget1296)=fail then Error("image subgroups not conjugate");fi;
nb:=Normalizer(S,Ktarget1296);;cb:=Centralizer(nb,Ktarget1296);;
if Size(nb)<>69984 or Size(cb)<>486 or not IsSubgroup(O,cb) then Error("global normalizer/centralizer mismatch");fi;
P:=PreImage(rho,Ktarget1296);;cl:=PreImage(rho,cb);;cp:=Centralizer(cl,P);;
if Size(P)<>81 or Size(cl)<>1458 or Size(cp)<>162 then Error("translation kernel mismatch");fi;
fullorder:=Size(nb)/Size(cb)*Size(cl)/Size(cp);;
if fullorder<>1296 then Error("wrong full-cover automizer order");fi;
Print("unitary H81: N=",Size(nt)," C=",Size(ct)," A=",Size(F),"; O3=",Size(PCore(F,3)),"; Sylow2=",IdGroup(SylowSubgroup(F,2)),"\n");
Print("global base K27: N=",Size(nb)," C=",Size(cb),"; cover translation kernel=",Size(cl)/Size(cp),"; full cover automizer order=",fullorder,"\n");
Print("F1296 FULL 3.FI22 AND 6.FI22 PRESENCE CHECKS PASSED\n");
# Intrinsic identification of the full covering automizer and its action.
f3can:=GF(3);;onecan:=One(f3can);;zerocan:=Zero(f3can);;
ican:=[[zerocan,onecan],[-onecan,zerocan]];;
jcan:=[[onecan,onecan],[onecan,-onecan]];;
Kcanonical:=Group(KroneckerProduct(IdentityMat(2,f3can),ican),
 KroneckerProduct(IdentityMat(2,f3can),jcan),
 DiagonalMat([onecan,onecan,-onecan,-onecan]));;
VcanonicalList:=AsList(FullRowSpace(f3can,4));;
LinCanonical:=List(GeneratorsOfGroup(Kcanonical),g->PermList(
 List(VcanonicalList,v->Position(VcanonicalList,v*g))));;
TrCanonical:=List(IdentityMat(4,f3can),e->PermList(
 List(VcanonicalList,v->Position(VcanonicalList,v+e))));;
Fcanonical:=Group(Concatenation(LinCanonical,TrCanonical));;
Assert(0,Size(Fcanonical)=1296 and IdGroup(Kcanonical)=[16,12]);
Assert(0,IsomorphismGroups(Fcanonical,F)<>fail);
Vcanonical:=PCore(Fcanonical,3);;
Assert(0,Size(Vcanonical)=81 and IsElementaryAbelian(Vcanonical));
Assert(0,Size(PCore(Fcanonical,2))=1);
NormalsCanonical:=NormalSubgroups(Fcanonical);;
Assert(0,SortedList(List(Filtered(NormalsCanonical,h->IsPGroup(h) and
 (Size(h)=1 or PrimeDivisors(Size(h))=[3])),Size))=[1,9,9,81]);
WeightOrbitsCanonical:=Orbits(Kcanonical,
 Filtered(VcanonicalList,v->not IsZero(v)),OnRight);;
Assert(0,SortedList(List(WeightOrbitsCanonical,o->[Length(o),RankMat(o)]))=
 [[8,2],[8,2],[16,4],[16,4],[16,4],[16,4]]);
Assert(0,Size(Centralizer(Vcanonical,
 DerivedSubgroup(SylowSubgroup(Fcanonical,2))))=1);
Print("canonical action: two irreducible planes; nonzero weight orbits 8,8,16,16,16,16; no normal C3\n");
# Verify also the fixed matrix input used by every absence branch.
Read("gap/data/fi22_target1296_matrix4.g");;
LinFileTarget:=List(GeneratorsOfGroup(TargetK16),g->PermList(
 List(VcanonicalList,v->Position(VcanonicalList,v*g))));;
FfileTarget:=Group(Concatenation(LinFileTarget,TrCanonical));;
Assert(0,Size(FfileTarget)=1296 and IsomorphismGroups(FfileTarget,Fcanonical)<>fail);
Print("fixed absence-input matrix group matches the actual full covering automizer\n");
Print("ALL F1296 FULL COVER PRESENCE AND ACTION CHECKS PASSED\n");
Print("FINAL\n");
QUIT;
