# Lemma 5.6.2 (location of an abelian realizer)
#
# Complete small Brauer degree lists of L3(4) and its three outer extensions.
#
# Expected: the recorded output (GAP 4.12.1) ends with
#   p23 degrees=[ 1, 1, 20, 20, 35, 35, 70, 90, 63, 63, 63, 63, 64, 64 ]
# Original file: co1_l34outer_modules.g (L. Gong and Y. Yan, 2026-10-25).
# Usage: gap -q --quitonbreak gap/lib.g gap/lemma_5_6_2_modules.g
LoadPackage("ctbllib");;
for nm in ["L3(4)","L3(4).2_1","L3(4).2_2","L3(4).2_3"] do
 tt:=CharacterTable(nm);;
 if tt<>fail then
 Print(nm," ordinarydegrees=",List(Irr(tt),chi->chi[1]),"\n");
 for pp in [2,3,5,7,11,13,23] do
  bt:=tt mod pp;
  if bt<>fail then Print("p",pp," degrees=",List(Irr(bt),chi->chi[1]),"\n");fi;
 od;
 fi;
od;
expected:=[
["L3(4)",[ 1, 20, 35, 35, 35, 45, 45, 63, 63, 64 ],[[2,[ 1, 8, 8, 9, 9, 64 ]],[3,[ 1, 15, 15, 15, 19, 45, 45, 63, 63 ]],[5,[ 1, 20, 35, 35, 35, 45, 45, 63 ]],[7,[ 1, 19, 35, 35, 35, 45, 63, 63 ]],[11,[ 1, 20, 35, 35, 35, 45, 45, 63, 63, 64 ]],[13,[ 1, 20, 35, 35, 35, 45, 45, 63, 63, 64 ]],[23,[ 1, 20, 35, 35, 35, 45, 45, 63, 63, 64 ]]]],
["L3(4).2_1",[ 1, 1, 20, 20, 35, 35, 35, 35, 35, 35, 90, 126,  64, 64 ],[[2,[ 1, 16, 18, 64 ]],[3,[ 1, 1, 15, 15, 15, 15, 15, 15, 19, 19, 90, 126 ]],[5,[ 1, 1, 20, 20, 35, 35, 35, 35, 35, 35, 90, 63, 63 ]],[7,[ 1, 1, 19, 19, 35, 35, 35, 35, 35, 35, 45, 45, 126 ]],[11,[ 1, 1, 20, 20, 35, 35, 35, 35, 35, 35, 90, 126, 64, 64 ]],[13,[ 1, 1, 20, 20, 35, 35, 35, 35, 35, 35, 90, 126, 64, 64 ]],[23,[ 1, 1, 20, 20, 35, 35, 35, 35, 35, 35, 90, 126, 64, 64 ]]]],
["L3(4).2_2",[ 1, 1, 20, 20, 35, 35, 70, 45, 45, 45, 45, 126,  64, 64 ],[[2,[ 1, 16, 9, 9, 64 ]],[3,[ 1, 1, 15, 15, 30, 19, 19, 45, 45, 45, 45, 126 ]],[5,[ 1, 1, 20, 20, 35, 35, 70, 45, 45, 45, 45, 63, 63 ]],[7,[ 1, 1, 19, 19, 35, 35, 70, 45, 45, 126 ]],[11,[ 1, 1, 20, 20, 35, 35, 70, 45, 45, 45, 45, 126, 64, 64 ]],[13,[ 1, 1, 20, 20, 35, 35, 70, 45, 45, 45, 45, 126, 64, 64 ]],[23,[ 1, 1, 20, 20, 35, 35, 70, 45, 45, 45, 45, 126, 64, 64 ]]]],
["L3(4).2_3",[ 1, 1, 20, 20, 35, 35, 70, 90, 63, 63, 63, 63, 64,  64 ],[[2,[ 1, 8, 8, 18, 64 ]],[3,[ 1, 1, 15, 15, 30, 19, 19, 90, 63, 63, 63, 63 ]],[5,[ 1, 1, 20, 20, 35, 35, 70, 90, 63, 63 ]],[7,[ 1, 1, 19, 19, 35, 35, 70, 45, 45, 63, 63, 63, 63 ]],[11,[ 1, 1, 20, 20, 35, 35, 70, 90, 63, 63, 63, 63, 64, 64 ]],[13,[ 1, 1, 20, 20, 35, 35, 70, 90, 63, 63, 63, 63, 64, 64 ]],[23,[ 1, 1, 20, 20, 35, 35, 70, 90, 63, 63, 63, 63, 64, 64 ]]]]];;
Assert(0,List(expected,r->[r[1],List(Irr(CharacterTable(r[1])),chi->chi[1]),List(Filtered([2,3,5,7,11,13,23],p->CharacterTable(r[1]) mod p<>fail),p->[p,List(Irr(CharacterTable(r[1]) mod p),chi->chi[1])])])=expected);
Print("ALL DEGREE LISTS AGREE WITH THE RECORDED LISTS\n");
Print("FINAL\n");
QUIT;
